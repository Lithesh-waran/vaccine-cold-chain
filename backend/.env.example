# ---------------------------------------------------------------
# Copy this file to ".env" (or simply run `npm run setup`, which
# also generates a strong JWT_SECRET for you).
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string (local instance by default)
MONGODB_URI=mongodb://127.0.0.1:27017/vaccine_cold_chain

# REQUIRED. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Comma separated list of allowed browser origins (use * to allow all in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Simulation engine defaults (can be overridden per simulation via the API) -----
# Wall-clock time between simulation ticks
SIM_TICK_INTERVAL_MS=3000
# Simulated seconds that pass per real second (60 => 1 real second = 1 simulated minute)
SIM_TIME_SCALE=60
# Cruise speed of the virtual vehicle
SIM_CRUISE_SPEED_KMPH=50
# Expected delivery = planned travel time * this factor (used when none is supplied)
SIM_ETA_BUFFER_FACTOR=1.25
# No temperature reading for this many real milliseconds => SENSOR_FAILURE alert
SIM_SENSOR_TIMEOUT_MS=10000
# Default allowed distance from the planned route before ROUTE_DEVIATION is raised
SIM_ROUTE_TOLERANCE_KM=2

# ----- Alerts / inventory -----
EXPIRY_WARNING_DAYS=30
INVENTORY_SCAN_INTERVAL_MINUTES=15

# ----- Seed script only (demo passwords; change them if you like) -----
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OPERATOR_PASSWORD=Operator@12345
SEED_WAREHOUSE_PASSWORD=Warehouse@12345
